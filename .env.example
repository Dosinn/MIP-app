# PostgreSQL (shared between Spring Boot and FastAPI)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=university_db


# JWT signing secret — must be at least 32 characters, keep this private!
JWT_SECRET=change-me-in-production-min-32-chars-long

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed email domains for user registration
ALLOWED_DOMAINS=@stuba.sk,gmail.com

# Directory inside the container where uploaded files are stored
UPLOAD_DIR=/storage/uploads

# Async database connection URL — uses the PostgreSQL credentials above
DATABASE_URL=postgresql+asyncpg://postgres:change-me-in-production@db:5432/university_db

# HuggingFace model identifier for Slovak sentence embeddings
MODEL_NAME=kinit/slovakbert-sts-stsb

# Number of similar projects to return per query
SIMILARITY_K=5

# Minimum cosine similarity score to include a result (0.0 – 1.0)
SIMILARITY_THRESHOLD=0.48

# Embedding blend weights — must sum to 1.0
TITLE_WEIGHT=0.3
DESC_WEIGHT=0.7

# Extra CORS allowed origins (comma-separated, optional)
# Use this to add a dev tunnel URL without editing code, e.g.:
#   CORS_ORIGINS=https://my-tunnel.ngrok-free.app
CORS_ORIGINS=
