# ==============================================================================
# Multi-Stage Dockerfile for React PWA Frontend + Nginx Gateway
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build React PWA Frontend
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder
WORKDIR /build

COPY FrontEnd/package*.json ./
RUN npm ci

COPY FrontEnd/ ./
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Ultralight Nginx Alpine Gateway
# ------------------------------------------------------------------------------
FROM nginx:alpine

# Copy built frontend assets to webroot
COPY --from=builder /build/dist /var/www/html

# Copy Nginx reverse proxy configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Port 80 for ONCE & Web Traffic
EXPOSE 80

# Health check
HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/up || exit 1

CMD ["nginx", "-g", "daemon off;"]
